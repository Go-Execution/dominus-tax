{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "tsx server/src/index.ts",
    "test:api": "tsx --test server/test/**/*.test.ts",
    "typecheck:api": "tsc --noEmit -p server/tsconfig.json",
    "typecheck:vercel": "tsc --noEmit -p tsconfig.api.json",
    "build": "vite build",
    "build:vercel": "npm run typecheck && npm run typecheck:vercel && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^8.3.4"
  }
}
