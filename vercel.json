{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/health", "destination": "/api/website?health=1" },
    { "source": "/cms", "destination": "/cms.html" },
    { "source": "/crm", "destination": "/portal.html" }
  ],
  "redirects": [
    { "source": "/services", "destination": "/#services", "permanent": true },
    { "source": "/about", "destination": "/#firm", "permanent": true },
    { "source": "/contact", "destination": "/#book", "permanent": true },
    { "source": "/admin", "destination": "/crm", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
