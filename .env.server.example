# Local API configuration. Copy to .env.server only when needed.
PORT=8787
DOMINUS_DB_PATH=.local-data/dominus.db
GHL_INTEGRATION_MODE=mock

# Vercel/Supabase server variables (never expose these as VITE_*).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-server-secret-key
INTAKE_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Keep future GHL credentials server-side. Never prefix these with VITE_.
# GHL_PRIVATE_INTEGRATION_TOKEN=
# GHL_LOCATION_ID=
