# Public embed URLs. These are safe to expose in the browser bundle.
VITE_CLIENT_INTAKE_FORM_URL=https://form.jotform.com/jsform/262376514662461
VITE_CONSULTANT_ONBOARDING_FORM_URL=https://form.jotform.com/jsform/262339213591053

# Browser-safe Supabase values from Project Settings → API Keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Local development only. Vite does not expose this bypass in production builds.
VITE_LOCAL_ADMIN_BYPASS=true

# Never place GoHighLevel API keys or webhook secrets in VITE_* variables.
